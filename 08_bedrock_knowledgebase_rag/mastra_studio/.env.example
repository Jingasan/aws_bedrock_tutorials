# mastra dev サーバー (Node 側) が読み込む環境変数の例。
# このファイルを .env にコピーし、terraform output の値で埋める。
# (.env は .gitignore 済み。ブラウザには一切露出しない)

# 認証情報の解決に使う AWS プロファイル名 (terraform の aws_profile と合わせる)
AWS_PROFILE=default
# Knowledge Base / bedrock-runtime のリージョン (terraform output aws_region)
AWS_REGION=ap-northeast-1
# チャット応答生成に使うモデル (terraform output model_id)
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5
# 社内規則を検索する Knowledge Base の ID (terraform output knowledge_base_id) ※必須
BEDROCK_KNOWLEDGE_BASE_ID=
