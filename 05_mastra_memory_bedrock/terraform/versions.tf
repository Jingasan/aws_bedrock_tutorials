#============================================================
# バージョン制約
# Terraform 本体と AWS プロバイダの利用可能バージョンを固定する。
#============================================================

terraform {
  # Terraform 本体の最低バージョン
  required_version = ">= 1.10"

  required_providers {
    aws = {
      source = "hashicorp/aws"
      # AWS プロバイダはメジャーバージョン 6 系に固定
      version = "~> 6.0"
    }
  }
}
